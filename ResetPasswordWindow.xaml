<Window x:Class="AgendamentoWpfApp.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Redefinir senha - SparkCore"
        Icon="Assets/SparkCore.ico"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SparkDeskBrush}">
    <!-- Mesmo design system do login. Estilos centralizados em Styles/. -->
    <Grid Margin="24">
        <Border Background="White"
                BorderBrush="#99FFFFFF"
                BorderThickness="1"
                CornerRadius="14"
                Padding="36,30">
            <Border.Effect>
                <DropShadowEffect Color="#140E08" BlurRadius="60" ShadowDepth="18" Direction="270" Opacity="0.4" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Redefinir senha"
                           Foreground="{StaticResource SparkInkBrush}"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock x:Name="SubtitleTextBlock"
                           Text="Digite o código enviado por e-mail e escolha a nova senha."
                           Foreground="{StaticResource SparkMutedBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,6,0,20" />

                <TextBlock Text="Código recebido por e-mail" Style="{StaticResource SparkFieldLabelStyle}" />
                <TextBox x:Name="CodeTextBox"
                         Style="{StaticResource SparkTextBoxStyle}"
                         MaxLength="6"
                         Margin="0,0,0,14" />

                <TextBlock Text="Nova senha (mínimo 8 caracteres)" Style="{StaticResource SparkFieldLabelStyle}" />
                <PasswordBox x:Name="NewPasswordBox"
                             Style="{StaticResource SparkPasswordBoxStyle}"
                             Margin="0,0,0,14" />

                <TextBlock Text="Confirmar nova senha" Style="{StaticResource SparkFieldLabelStyle}" />
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Style="{StaticResource SparkPasswordBoxStyle}"
                             Margin="0,0,0,16" />

                <TextBlock x:Name="StatusTextBlock"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,0,0,14" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CancelButton"
                            Grid.Column="0"
                            Content="Cancelar"
                            Style="{StaticResource SparkSecondaryButtonStyle}"
                            Click="CancelButton_Click" />
                    <Button x:Name="ConfirmButton"
                            Grid.Column="2"
                            Content="Redefinir senha"
                            Style="{StaticResource SparkPrimaryButtonStyle}"
                            Click="ConfirmButton_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>

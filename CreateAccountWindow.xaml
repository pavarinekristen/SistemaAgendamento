<Window x:Class="AgendamentoWpfApp.CreateAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Criar conta - SparkCore"
        Icon="Assets/SparkCore.ico"
        Width="760"
        Height="680"
        MinWidth="720"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SparkPageBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#1C1713" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8A7C6C" />
        <SolidColorBrush x:Key="LineBrush" Color="#E8DFCE" />
        <SolidColorBrush x:Key="FieldBrush" Color="#FBF8F2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E8720F" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#C95E0C" />

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#D8C6A8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="FieldBorder" Property="BorderThickness" Value="1.6" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#D8C6A8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="FieldBorder" Property="BorderThickness" Value="1.6" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CBBFAE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Border Background="White"
                BorderBrush="#E8DFCE"
                BorderThickness="1"
                CornerRadius="16"
                Padding="36">
            <Border.Effect>
                <DropShadowEffect Color="#1C1713"
                                  BlurRadius="28"
                                  ShadowDepth="4"
                                  Direction="270"
                                  Opacity="0.14" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Criar conta"
                               Foreground="{StaticResource InkBrush}"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Cadastre a empresa, receba o codigo no e-mail e confirme o acesso."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="14"
                               Margin="0,8,0,26" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CNPJ" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="CnpjTextBox"
                                 Style="{StaticResource FieldTextBoxStyle}"
                                 TextChanged="CnpjTextBox_TextChanged"
                                 Margin="0,0,0,14" />

                        <TextBlock Text="Razao social" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="RazaoSocialTextBox"
                                 Style="{StaticResource FieldTextBoxStyle}"
                                 Margin="0,0,0,14" />

                        <TextBlock Text="Nome fantasia" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="NomeFantasiaTextBox"
                                 Style="{StaticResource FieldTextBoxStyle}"
                                 Margin="0,0,0,14" />

                        <TextBlock Text="Nome do usuario" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="UsuarioNomeTextBox"
                                 Style="{StaticResource FieldTextBoxStyle}"
                                 Margin="0,0,0,14" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="E-mail" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="EmailTextBox"
                                 Style="{StaticResource FieldTextBoxStyle}"
                                 Margin="0,0,0,14" />

                        <TextBlock Text="Senha" Style="{StaticResource LabelStyle}" />
                        <PasswordBox x:Name="SenhaBox"
                                     Style="{StaticResource FieldPasswordBoxStyle}"
                                     Margin="0,0,0,14" />

                        <TextBlock Text="Codigo recebido por e-mail" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="CodigoTextBox"
                                 Style="{StaticResource FieldTextBoxStyle}"
                                 TextChanged="CodigoTextBox_TextChanged"
                                 Margin="0,0,0,14" />

                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="CreateButton"
                                    Content="Enviar codigo"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="CreateButton_Click" />

                            <Button x:Name="ConfirmButton"
                                    Grid.Column="2"
                                    Content="Confirmar"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="ConfirmButton_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <Border x:Name="StatusBorder"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Background="#FFF6E8"
                        BorderBrush="#F2D9B8"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,24,0,0">
                    <TextBlock x:Name="StatusTextBlock"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <TextBlock Text="Feito com ❤️ pela Sparkware"
                   Foreground="#8A7C6C"
                   Opacity="0.58"
                   FontSize="11"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,12,8"
                   IsHitTestVisible="False" />
    </Grid>
</Window>

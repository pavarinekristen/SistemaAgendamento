<Window x:Class="AgendamentoWpfApp.CreateAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Criar conta - SparkCore"
        Icon="Assets/SparkCore.ico"
        Width="820"
        Height="720"
        MinWidth="760"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SparkDeskBrush}">
    <!-- Mesmo design system do login. Estilos centralizados em Styles/. -->
    <Grid Margin="28">
        <Border Background="White"
                BorderBrush="#99FFFFFF"
                BorderThickness="1"
                CornerRadius="14"
                Padding="44,38">
            <Border.Effect>
                <DropShadowEffect Color="#140E08" BlurRadius="60" ShadowDepth="18" Direction="270" Opacity="0.4" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cabecalho com marca -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                        <Border Width="40" Height="40" CornerRadius="11"
                                Background="{StaticResource SparkLogoGradientBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#E0670A" BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.6" />
                            </Border.Effect>
                            <Grid Width="24" Height="24">
                                <Ellipse Width="21" Height="21"
                                         Stroke="#8CFFFFFF" StrokeThickness="1.8"
                                         StrokeDashArray="6.8,3" StrokeDashCap="Round" />
                                <Path Data="M17.6,6.8 L10.4,17.2 L14.7,17.2 L13.7,25.2 L21.6,13.8 L17,13.8 Z"
                                      Fill="White" Stretch="Uniform" Width="9" Height="14"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0" />
                            </Grid>
                        </Border>
                        <TextBlock Text="SparkCore" Foreground="{StaticResource SparkInkBrush}"
                                   FontWeight="Bold" FontSize="17"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="Criar conta"
                               Foreground="{StaticResource SparkInkBrush}"
                               FontSize="30"
                               FontWeight="Bold" />
                    <TextBlock Text="Cadastre a empresa, receba o código no e-mail e confirme o acesso."
                               Foreground="{StaticResource SparkMutedBrush}"
                               FontSize="14"
                               Margin="0,8,0,26" />
                </StackPanel>

                <!-- Formulario em duas colunas -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CNPJ" Style="{StaticResource SparkFieldLabelStyle}" />
                        <TextBox x:Name="CnpjTextBox"
                                 Style="{StaticResource SparkTextBoxStyle}"
                                 TextChanged="CnpjTextBox_TextChanged"
                                 Margin="0,0,0,16" />

                        <TextBlock Text="Razão social" Style="{StaticResource SparkFieldLabelStyle}" />
                        <TextBox x:Name="RazaoSocialTextBox"
                                 Style="{StaticResource SparkTextBoxStyle}"
                                 Margin="0,0,0,16" />

                        <TextBlock Text="Nome fantasia" Style="{StaticResource SparkFieldLabelStyle}" />
                        <TextBox x:Name="NomeFantasiaTextBox"
                                 Style="{StaticResource SparkTextBoxStyle}"
                                 Margin="0,0,0,16" />

                        <TextBlock Text="Nome do usuário" Style="{StaticResource SparkFieldLabelStyle}" />
                        <TextBox x:Name="UsuarioNomeTextBox"
                                 Style="{StaticResource SparkTextBoxStyle}"
                                 Margin="0,0,0,16" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="E-mail" Style="{StaticResource SparkFieldLabelStyle}" />
                        <TextBox x:Name="EmailTextBox"
                                 Style="{StaticResource SparkTextBoxStyle}"
                                 Margin="0,0,0,16" />

                        <TextBlock Text="Senha" Style="{StaticResource SparkFieldLabelStyle}" />
                        <PasswordBox x:Name="SenhaBox"
                                     Style="{StaticResource SparkPasswordBoxStyle}"
                                     Margin="0,0,0,16" />

                        <TextBlock Text="Código recebido por e-mail" Style="{StaticResource SparkFieldLabelStyle}" />
                        <TextBox x:Name="CodigoTextBox"
                                 Style="{StaticResource SparkTextBoxStyle}"
                                 TextChanged="CodigoTextBox_TextChanged"
                                 Margin="0,0,0,16" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="CreateButton"
                                    Content="Enviar código"
                                    Height="46"
                                    Style="{StaticResource SparkPrimaryButtonStyle}"
                                    Click="CreateButton_Click" />

                            <Button x:Name="ConfirmButton"
                                    Grid.Column="2"
                                    Content="Confirmar"
                                    Height="46"
                                    Style="{StaticResource SparkPrimaryButtonStyle}"
                                    Click="ConfirmButton_Click" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Status -->
                <Border x:Name="StatusBorder"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Background="#FDF3EA"
                        BorderBrush="#F7E0CC"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,22,0,0">
                    <TextBlock x:Name="StatusTextBlock"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Rodape -->
                <Border Grid.Row="3"
                        BorderBrush="#F4EFEA" BorderThickness="0,1,0,0"
                        Padding="0,18,0,0" Margin="0,26,0,0">
                    <TextBlock FontSize="11.5"
                               Foreground="{StaticResource SparkFaintBrush}"
                               HorizontalAlignment="Center">
                        <Run Text="Feito com" />
                        <Run Text="♥" Foreground="{StaticResource SparkAccentBrush}" />
                        <Run Text="pela Sparkware" />
                    </TextBlock>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

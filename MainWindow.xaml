<Window x:Class="AgendamentoWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SparkCore"
        Icon="Assets/SparkCore.ico"
        Width="980"
        Height="640"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SparkPageBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#1C1713" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8A7C6C" />
        <SolidColorBrush x:Key="LineBrush" Color="#E8DFCE" />
        <SolidColorBrush x:Key="FieldBrush" Color="#FBF8F2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E8720F" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#C95E0C" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#C0392B" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#2F6B4F" />

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#D8C6A8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="FieldBorder" Property="BorderThickness" Value="1.6" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="FieldBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#D8C6A8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="FieldBorder" Property="BorderThickness" Value="1.6" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#CBBFAE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Border CornerRadius="16"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#1C1713"
                                  BlurRadius="28"
                                  ShadowDepth="4"
                                  Direction="270"
                                  Opacity="0.14" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.92*" />
                    <ColumnDefinition Width="1.08*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="16,0,0,16"
                        Background="{StaticResource SparkDarkPanelBrush}"
                        Padding="46">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <Border Width="52"
                                    Height="52"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="12"
                                    Margin="0,0,0,28">
                                <TextBlock Text="SC"
                                           FontWeight="Bold"
                                           FontSize="19"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="SparkCore"
                                       Foreground="White"
                                       FontSize="34"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       LineHeight="40" />
                            <Border Width="46"
                                    Height="4"
                                    CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left"
                                    Margin="0,14,0,0" />
                            <TextBlock Text="Acesso administrativo"
                                       Foreground="#CDBFAE"
                                       FontSize="16"
                                       Margin="0,16,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="Desktop Windows"
                                   Foreground="#9C8D7A"
                                   FontSize="13" />
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        CornerRadius="0,16,16,0"
                        Background="White"
                        Padding="58,50">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Width="390" VerticalAlignment="Center">
                            <TextBlock Text="Entrar"
                                       Foreground="{StaticResource InkBrush}"
                                       FontSize="30"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Use seu e-mail e senha cadastrados."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="14"
                                       Margin="0,8,0,30" />

                            <TextBlock Text="E-mail" Style="{StaticResource LabelStyle}" />
                            <TextBox x:Name="EmailTextBox"
                                     Style="{StaticResource FieldTextBoxStyle}"
                                     Margin="0,0,0,18" />

                            <TextBlock Text="Senha" Style="{StaticResource LabelStyle}" />
                            <PasswordBox x:Name="PasswordBox"
                                         Style="{StaticResource FieldPasswordBoxStyle}"
                                         Margin="0,0,0,24" />

                            <Button x:Name="LoginButton"
                                    Content="Entrar"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="LoginButton_Click" />

                            <Button Content="Criar conta"
                                    Height="42"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{StaticResource AccentBrush}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Margin="0,12,0,0"
                                    Click="CreateAccountButton_Click" />

                            <Border x:Name="StatusBorder"
                                    Visibility="Collapsed"
                                    Background="#FFF6E8"
                                    BorderBrush="#F2D9B8"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,18,0,0">
                                <TextBlock x:Name="StatusTextBlock"
                                           Foreground="{StaticResource InkBrush}"
                                           FontSize="13"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="ApiInfoTextBlock"
                                   Grid.Row="1"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <TextBlock Text="Feito com ❤️ pela Sparkware"
                   Foreground="#8A7C6C"
                   Opacity="0.58"
                   FontSize="11"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,12,8"
                   IsHitTestVisible="False" />
    </Grid>
</Window>

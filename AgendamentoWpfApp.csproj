<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\SparkCore.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AgendamentoWpfApp.Smoke\**\*.cs" />
    <Compile Remove="AgendamentoWpfApp.Tests\**\*.cs" />
    <Compile Remove="Tools\**\*.cs" />
    <Compile Remove="artifacts\**\*.cs" />
    <None Remove="AgendamentoWpfApp.Smoke\**\*" />
    <None Remove="AgendamentoWpfApp.Tests\**\*" />
    <None Remove="Tools\**\*" />
    <None Remove="artifacts\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\SparkCore.ico" />
    <Resource Include="Assets\SparkCore.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="PublishSparkCoreUpdater" BeforeTargets="Publish">
    <MSBuild Projects="Tools\SparkCore.Updater\SparkCore.Updater.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;PublishDir=$(MSBuildProjectDirectory)\artifacts\updater-publish\" />
  </Target>

  <Target Name="CopySparkCoreUpdaterToPublish" AfterTargets="Publish">
    <ItemGroup>
      <SparkCoreUpdaterPublishFiles Include="$(MSBuildProjectDirectory)\artifacts\updater-publish\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SparkCoreUpdaterPublishFiles)"
          DestinationFiles="@(SparkCoreUpdaterPublishFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>

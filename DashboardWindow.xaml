<Window x:Class="AgendamentoWpfApp.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AgendamentoWpfApp.Views"
        Title="SparkCore"
        Icon="Assets/SparkCore.ico"
        Width="1240"
        Height="780"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SparkPageBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#1C1713" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8A7C6C" />
        <SolidColorBrush x:Key="LineBrush" Color="#E8DFCE" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E8720F" />
        <SolidColorBrush x:Key="SoftAccentBrush" Color="#FCEBD9" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource SparkMutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0,0,0,4" />
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SparkTextBoxStyle}" />

        <Style TargetType="DatePicker" BasedOn="{StaticResource SparkDatePickerStyle}" />

        <Style TargetType="ComboBox" BasedOn="{StaticResource SparkComboBoxStyle}" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SparkPrimaryButtonStyle}" />

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SparkSecondaryButtonStyle}" />

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SparkDangerButtonStyle}" />

        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource SparkNavButtonStyle}" />

        <Style x:Key="HiddenTabItemStyle" TargetType="TabItem">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34"
                            Height="34"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="9"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="SC"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SparkCore"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SessionSummaryTextBlock"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Sair"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="LogoutButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#F1EBDE"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="Modulos"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,0,0,12" />
                    <Button Content="Clientes"
                            Style="{StaticResource NavButtonStyle}"
                            Click="MenuClientesButton_Click" />
                    <Button Content="Agenda"
                            Style="{StaticResource NavButtonStyle}"
                            Click="MenuAgendaButton_Click" />
                    <Button Content="Servicos"
                            Style="{StaticResource NavButtonStyle}"
                            IsEnabled="False" />
                    <Button Content="Profissionais"
                            Style="{StaticResource NavButtonStyle}"
                            Click="MenuProfissionaisButton_Click" />
                    <Button Content="Laudos"
                            Style="{StaticResource NavButtonStyle}"
                            Click="MenuLaudosButton_Click" />
                    <Button Content="Configuracoes"
                            Style="{StaticResource NavButtonStyle}"
                            Click="MenuConfiguracoesButton_Click" />
                </StackPanel>
            </Border>

            <TabControl x:Name="MainTabControl"
                        Grid.Column="1"
                        Margin="20"
                        BorderThickness="0"
                        Background="Transparent"
                        ItemContainerStyle="{StaticResource HiddenTabItemStyle}">
                <TabItem Header="Clientes">
                    <views:ClientesView x:Name="ClientesView"
                                        SearchChanged="ClientesView_SearchChanged"
                                        SelectionChanged="ClientesView_SelectionChanged"
                                        SaveRequested="ClientesView_SaveRequested"
                                        NewRequested="ClientesView_NewRequested"
                                        DeleteRequested="ClientesView_DeleteRequested" />
                </TabItem>

                <TabItem Header="Agenda">
                    <views:AgendaView x:Name="AgendaView"
                                      DateChanged="AgendaView_DateChanged"
                                      SelectionChanged="AgendaView_SelectionChanged"
                                      SaveRequested="AgendaView_SaveRequested"
                                      NewRequested="AgendaView_NewRequested"
                                      DeleteRequested="AgendaView_DeleteRequested" />
                </TabItem>

                <TabItem Header="Profissionais">
                    <views:ProfissionaisView x:Name="ProfissionaisView"
                                             SelectionChanged="ProfissionaisView_SelectionChanged"
                                             SaveRequested="ProfissionaisView_SaveRequested"
                                             NewRequested="ProfissionaisView_NewRequested"
                                             DeleteRequested="ProfissionaisView_DeleteRequested" />
                </TabItem>

                <TabItem Header="Laudos">
                    <views:LaudosView x:Name="LaudosView"
                                      ClienteSelectionChanged="LaudosView_ClienteSelectionChanged"
                                      GerarPdfRequested="LaudosView_GerarPdfRequested" />
                </TabItem>

                <TabItem Header="Configuracoes">
                    <views:ConfiguracoesView x:Name="ConfiguracoesView"
                                             LogoutRequested="ConfiguracoesView_LogoutRequested" />
                </TabItem>
            </TabControl>
        </Grid>

        <TextBlock Grid.RowSpan="2"
                   Style="{StaticResource SparkWatermarkStyle}" />
    </Grid>
</Window>

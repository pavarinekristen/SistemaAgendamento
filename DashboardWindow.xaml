<Window x:Class="AgendamentoWpfApp.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AgendamentoWpfApp.Views"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SparkCore"
        Icon="Assets/SparkCore.ico"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SparkPageBrush}">
    <!-- Shell com header neutro, lateral recolhivel e conteudo espacoso. -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SparkInkBrush}" />
        </Style>

        <Style TargetType="Label" BasedOn="{StaticResource SparkFormLabelStyle}" />

        <!-- Botao de icone da barra superior escura -->
        <Style x:Key="TopBarIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle do perfil na barra superior -->
        <Style x:Key="TopBarProfileToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2BFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item do menu de perfil -->
        <Style x:Key="ProfileMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F6F1EA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== TOP STRIP ===== -->
        <Border Grid.Row="0"
                Background="#2A2118"
                Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="4">
                        <Border.Background>
                            <ImageBrush ImageSource="/Assets/SparkCoreLogo.png" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <TextBlock Text="SparkCore"
                               Margin="10,0,0,0"
                               Foreground="#AFA79E"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />

                    <!-- Hamburguer: abre/fecha o menu lateral -->
                    <Button x:Name="SidebarToggleButton"
                            Style="{StaticResource TopBarIconButtonStyle}"
                            Margin="16,0,0,0"
                            ToolTip="Abrir ou fechar o menu"
                            Click="SidebarToggleButton_Click">
                        <StackPanel>
                            <Rectangle Width="15" Height="2" RadiusX="1" RadiusY="1" Fill="#CFC8BF" />
                            <Rectangle Width="15" Height="2" RadiusX="1" RadiusY="1" Fill="#CFC8BF" Margin="0,3.5" />
                            <Rectangle Width="15" Height="2" RadiusX="1" RadiusY="1" Fill="#CFC8BF" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- Sino de notificacoes -->
                    <Grid VerticalAlignment="Center">
                        <Button x:Name="NotificationsButton"
                                Style="{StaticResource TopBarIconButtonStyle}"
                                ToolTip="Notificações"
                                Click="NotificationsButton_Click">
                            <Path Data="M18,8 A6,6 0 0 0 6,8 C6,15 3,17 3,17 L21,17 C21,17 18,15 18,8 M13.7,21 A2,2 0 0 1 10.3,21"
                                  Stroke="#CFC8BF" StrokeThickness="1.8"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="17" Height="17" Stretch="Uniform" />
                        </Button>
                        <Border x:Name="NotificationBadge"
                                Background="{StaticResource SparkAccentBrush}"
                                CornerRadius="8"
                                MinWidth="16"
                                Height="16"
                                Padding="4,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-3,-3,0"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <TextBlock x:Name="NotificationBadgeTextBlock"
                                       Text="0"
                                       Foreground="White"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <Rectangle Width="1" Height="18" Fill="#2EFFFFFF" Margin="10,0" />

                    <!-- Perfil: avatar + nome + setinha -->
                    <ToggleButton x:Name="ProfileMenuToggle"
                                  Style="{StaticResource TopBarProfileToggleStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="13"
                                    Background="{StaticResource SparkAccentGradientBrush}">
                                <TextBlock x:Name="ProfileInitialsTextBlock"
                                           Text="U"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="ProfileNameTextBlock"
                                       Foreground="#E6DFD6"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Margin="9,0,7,0"
                                       MaxWidth="280"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Path Data="M6,9 L12,15 L18,9"
                                  Stroke="#9A9186" StrokeThickness="2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="11" Height="11" Stretch="Uniform"
                                  VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <!-- Popup de notificacoes -->
                    <Popup x:Name="NotificationsPopup"
                           PlacementTarget="{Binding ElementName=NotificationsButton}"
                           Placement="Custom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Margin="12"
                                Background="{StaticResource SparkSurfaceBrush}"
                                BorderBrush="{StaticResource SparkLineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,14"
                                Width="300">
                            <Border.Effect>
                                <DropShadowEffect Color="#1E140A" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.25" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Agenda de hoje" FontSize="13" FontWeight="Bold" Margin="0,0,0,8" />
                                <TextBlock x:Name="NotificationsEmptyTextBlock"
                                           Text="Nenhuma consulta agendada para hoje."
                                           FontSize="12"
                                           Foreground="{StaticResource SparkMutedBrush}"
                                           TextWrapping="Wrap" />
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="NotificationsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FBF7F1"
                                                        BorderBrush="{StaticResource SparkLineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9"
                                                        Padding="10,8"
                                                        Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{StaticResource SparkAccentBrush}"
                                                                CornerRadius="7"
                                                                Padding="7,2"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Horario, Mode=OneWay}"
                                                                       Foreground="White"
                                                                       FontSize="11"
                                                                       FontWeight="Bold" />
                                                        </Border>
                                                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ClienteNome, Mode=OneWay}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       MaxWidth="185"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="10.5"
                                                                       Foreground="{StaticResource SparkMutedBrush}"
                                                                       Margin="0,1,0,0">
                                                                <Run Text="{Binding Motivo, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Menu do perfil -->
                    <Popup x:Name="ProfileMenuPopup"
                           PlacementTarget="{Binding ElementName=ProfileMenuToggle}"
                           Placement="Custom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           IsOpen="{Binding IsChecked, ElementName=ProfileMenuToggle, Mode=TwoWay}">
                        <Border Margin="12"
                                Background="{StaticResource SparkSurfaceBrush}"
                                BorderBrush="{StaticResource SparkLineBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="10"
                                Width="260">
                            <Border.Effect>
                                <DropShadowEffect Color="#1E140A" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.25" />
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="8,8,8,10">
                                    <Border Width="38" Height="38" CornerRadius="19"
                                            Background="{StaticResource SparkAccentGradientBrush}">
                                        <TextBlock x:Name="ProfilePopupInitialsTextBlock"
                                                   Text="U"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="11,0,0,0">
                                        <TextBlock x:Name="ProfilePopupNameTextBlock"
                                                   FontSize="13.5"
                                                   FontWeight="Bold"
                                                   MaxWidth="165"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="ProfilePopupCompanyTextBlock"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource SparkMutedBrush}"
                                                   MaxWidth="165"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <Rectangle Height="1" Fill="{StaticResource SparkLineBrush}" Margin="4,0,4,8" />

                                <Button Style="{StaticResource ProfileMenuItemStyle}"
                                        Click="ProfileMenuConfiguracoes_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 M19.4,15 C19.1,15.6 19.2,16.4 19.7,16.9 L19.8,17 C20.6,17.8 20.6,19 19.8,19.8 C19,20.6 17.8,20.6 17,19.8 L16.9,19.7 C16.4,19.2 15.6,19.1 15,19.4 C14.4,19.7 14,20.3 14,21 L14,21 C14,22.1 13.1,23 12,23 C10.9,23 10,22.1 10,21 L10,20.9 C10,20.2 9.6,19.6 9,19.4 C8.4,19.1 7.6,19.2 7.1,19.7 L7,19.8 C6.2,20.6 5,20.6 4.2,19.8 C3.4,19 3.4,17.8 4.2,17 L4.3,16.9 C4.8,16.4 4.9,15.6 4.6,15 C4.3,14.4 3.7,14 3,14 L3,14 C1.9,14 1,13.1 1,12 C1,10.9 1.9,10 3,10 L3.1,10 C3.8,10 4.4,9.6 4.6,9 C4.9,8.4 4.8,7.6 4.3,7.1 L4.2,7 C3.4,6.2 3.4,5 4.2,4.2 C5,3.4 6.2,3.4 7,4.2 L7.1,4.3 C7.6,4.8 8.4,4.9 9,4.6 L9,4.6 C9.6,4.3 10,3.7 10,3 L10,3 C10,1.9 10.9,1 12,1 C13.1,1 14,1.9 14,3 L14,3.1 C14,3.8 14.4,4.4 15,4.6 C15.6,4.9 16.4,4.8 16.9,4.3 L17,4.2 C17.8,3.4 19,3.4 19.8,4.2 C20.6,5 20.6,6.2 19.8,7 L19.7,7.1 C19.2,7.6 19.1,8.4 19.4,9 L19.4,9 C19.7,9.6 20.3,10 21,10 L21,10 C22.1,10 23,10.9 23,12 C23,13.1 22.1,14 21,14 L20.9,14 C20.2,14 19.6,14.4 19.4,15 Z"
                                              Stroke="{StaticResource SparkMutedBrush}" StrokeThickness="1.8"
                                              StrokeLineJoin="Round"
                                              Width="16" Height="16" Stretch="Uniform"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="Configurações"
                                                   FontSize="12.5"
                                                   FontWeight="Medium"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Rectangle Height="1" Fill="{StaticResource SparkLineBrush}" Margin="4,8" />

                                <Button Style="{StaticResource ProfileMenuItemStyle}"
                                        Click="ProfileMenuSair_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M9,21 L5,21 C3.9,21 3,20.1 3,19 L3,5 C3,3.9 3.9,3 5,3 L9,3 M16,17 L21,12 L16,7 M21,12 L9,12"
                                              Stroke="#C0503A" StrokeThickness="2"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="16" Height="16" Stretch="Uniform"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="Sair"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#C0503A"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== CORPO ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR escura -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="{StaticResource SparkSidebarBrush}">
                <Grid ClipToBounds="True">
                    <!-- Glow que respira -->
                    <Ellipse Width="300" Height="300"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-120,-90,0,0"
                             RenderTransformOrigin="0.5,0.5"
                             Opacity="0.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#29F7931E" Offset="0" />
                                <GradientStop Color="#00F7931E" Offset="0.66" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.5" To="0.85" Duration="0:0:4.5" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         From="1" To="1.05" Duration="0:0:4.5" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         From="1" To="1.05" Duration="0:0:4.5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <!-- Quadriculado -->
                    <Border Background="{StaticResource SparkGridTextureBrush}" Opacity="0.4">
                        <Border.OpacityMask>
                            <RadialGradientBrush Center="0.3,0.1" GradientOrigin="0.3,0.1" RadiusX="1.2" RadiusY="0.8">
                                <GradientStop Color="#FF000000" Offset="0.3" />
                                <GradientStop Color="#00000000" Offset="0.8" />
                            </RadialGradientBrush>
                        </Border.OpacityMask>
                    </Border>

                    <Grid x:Name="SidebarContentGrid" Margin="16,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="M Ó D U L O S"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="#52FFFFFF"
                                   Margin="13,6,0,12" />

                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                            <Button x:Name="NavClientesButton"
                                    Style="{StaticResource SparkNavButtonStyle}"
                                    Tag="Active"
                                    Click="MenuClientesButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource SparkNavIconStyle}"
                                          Data="M16,21 L16,19 C16,16.8 14.2,15 12,15 L6,15 C3.8,15 2,16.8 2,19 L2,21 M13,7 A4,4 0 1 1 5,7 A4,4 0 1 1 13,7 M22,21 L22,19 C22,17.2 20.8,15.6 19,15.1 M16,3.1 C17.8,3.6 19,5.2 19,7 C19,8.8 17.8,10.4 16,10.9"
                                          Margin="0,0,12,0" />
                                    <TextBlock Text="Cadastro" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavAgendaButton"
                                    Style="{StaticResource SparkNavButtonStyle}"
                                    Click="MenuAgendaButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource SparkNavIconStyle}"
                                          Data="M6,4 L18,4 C19.7,4 21,5.3 21,7 L21,19 C21,20.7 19.7,22 18,22 L6,22 C4.3,22 3,20.7 3,19 L3,7 C3,5.3 4.3,4 6,4 Z M16,2 L16,6 M8,2 L8,6 M3,10 L21,10"
                                          Margin="0,0,12,0" />
                                    <TextBlock Text="Agenda" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavPesquisaButton"
                                    Style="{StaticResource SparkNavButtonStyle}"
                                    Click="MenuPesquisaButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource SparkNavIconStyle}"
                                          Data="M19,11 A8,8 0 1 1 3,11 A8,8 0 1 1 19,11 M21,21 L16.7,16.7"
                                          Margin="0,0,12,0" />
                                    <TextBlock Text="Pesquisa" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavServicosButton"
                                    Style="{StaticResource SparkNavButtonStyle}"
                                    IsEnabled="False">
                                <Grid HorizontalAlignment="Stretch" Width="178">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SparkNavIconStyle}"
                                              Data="M3,3 L10,3 L10,10 L3,10 Z M14,3 L21,3 L21,10 L14,10 Z M3,14 L10,14 L10,21 L3,21 Z M14,14 L21,14 L21,21 L14,21 Z"
                                              Margin="0,0,12,0" />
                                        <TextBlock Text="Serviços" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                    <Border x:Name="NavServicosBadge" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            BorderBrush="#24FFFFFF" BorderThickness="1"
                                            CornerRadius="5" Padding="6,2">
                                        <TextBlock Text="EM BREVE" FontSize="9" FontWeight="SemiBold" Foreground="#4DFFFFFF" />
                                    </Border>
                                </Grid>
                            </Button>

                            <Button x:Name="NavProfissionaisButton"
                                    Style="{StaticResource SparkNavButtonStyle}"
                                    Click="MenuProfissionaisButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource SparkNavIconStyle}"
                                          Data="M16,21 L16,19 C16,16.8 14.2,15 12,15 L6,15 C3.8,15 2,16.8 2,19 L2,21 M13,7 A4,4 0 1 1 5,7 A4,4 0 1 1 13,7 M17,11 L19,13 L23,9"
                                          Margin="0,0,12,0" />
                                    <TextBlock Text="Profissionais" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavLaudosButton"
                                    Style="{StaticResource SparkNavButtonStyle}"
                                    Click="MenuLaudosButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource SparkNavIconStyle}"
                                          Data="M14,2 L6,2 C4.9,2 4,2.9 4,4 L4,20 C4,21.1 4.9,22 6,22 L18,22 C19.1,22 20,21.1 20,20 L20,8 Z M14,2 L14,8 L20,8 M16,13 L8,13 M16,17 L8,17 M10,9 L8,9"
                                          Margin="0,0,12,0" />
                                    <TextBlock Text="Laudos" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>

                        </StackPanel>

                        <!-- Rodape da sidebar -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,0,0,0">
                            <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#22C55E" BlurRadius="6" ShadowDepth="0" Opacity="0.9" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="SidebarStatusTextBlock"
                                       Text="SparkCore v1.0.0"
                                       FontSize="11"
                                       Foreground="#4DFFFFFF"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- CONTEUDO -->
            <TabControl x:Name="MainTabControl"
                        Grid.Column="1"
                        Margin="24,24,24,18"
                        BorderThickness="0"
                        Background="Transparent"
                        ItemContainerStyle="{StaticResource SparkHiddenTabItemStyle}">
                <TabItem Header="Cadastro">
                    <views:ClientesView x:Name="ClientesView"
                                        SaveRequested="ClientesView_SaveRequested"
                                        NewRequested="ClientesView_NewRequested"
                                        DeleteRequested="ClientesView_DeleteRequested" />
                </TabItem>

                <TabItem Header="Agenda">
                    <views:AgendaView x:Name="AgendaView"
                                      DateChanged="AgendaView_DateChanged"
                                      SelectionChanged="AgendaView_SelectionChanged"
                                      ClienteSearchRequested="AgendaView_ClienteSearchRequested"
                                      SaveRequested="AgendaView_SaveRequested"
                                      NewRequested="AgendaView_NewRequested"
                                      DeleteRequested="AgendaView_DeleteRequested" />
                </TabItem>

                <TabItem Header="Pesquisa">
                    <views:PesquisaClientesView x:Name="PesquisaClientesView"
                                                FilterChanged="PesquisaClientesView_FilterChanged"
                                                SelectionChanged="PesquisaClientesView_SelectionChanged"
                                                EditRequested="PesquisaClientesView_EditRequested" />
                </TabItem>

                <TabItem Header="Profissionais">
                    <views:ProfissionaisView x:Name="ProfissionaisView"
                                             SelectionChanged="ProfissionaisView_SelectionChanged"
                                             SaveRequested="ProfissionaisView_SaveRequested"
                                             NewRequested="ProfissionaisView_NewRequested"
                                             DeleteRequested="ProfissionaisView_DeleteRequested" />
                </TabItem>

                <TabItem Header="Laudos">
                    <views:LaudosView x:Name="LaudosView"
                                      FiltrarRequested="LaudosView_FiltrarRequested"
                                      BaixarLaudoRequested="LaudosView_BaixarLaudoRequested"
                                      ImprimirRequested="LaudosView_ImprimirRequested"
                                      ExcluirRequested="LaudosView_ExcluirRequested" />
                </TabItem>

                <TabItem Header="Configuracoes">
                    <views:ConfiguracoesView x:Name="ConfiguracoesView"
                                             LogoutRequested="ConfiguracoesView_LogoutRequested" />
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Visualizador de laudo (PDF aberto dentro do sistema) -->
        <Grid x:Name="LaudoViewerOverlay"
              Grid.Row="0"
              Grid.RowSpan="3"
              Background="#D917110B"
              Visibility="Collapsed"
              Panel.ZIndex="998">
            <Grid MaxWidth="1080" Margin="46,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Barra do visualizador -->
                <Border Background="#2A2118" CornerRadius="14,14,0,0" Padding="14,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="20" Height="20" CornerRadius="5">
                                <Border.Background>
                                    <ImageBrush ImageSource="/Assets/SparkCoreLogo.png" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <TextBlock x:Name="LaudoViewerTitleTextBlock"
                                       Foreground="#E6DFD6"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="10,0,0,0"
                                       MaxWidth="440"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="LaudoViewerHintTextBlock"
                                       Foreground="#8FE0A9"
                                       FontSize="12"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Baixar"
                                    Style="{StaticResource SparkPrimaryButtonStyle}"
                                    Click="LaudoViewerBaixar_Click" />
                            <Button Content="Compartilhar"
                                    Style="{StaticResource SparkSecondaryButtonStyle}"
                                    Margin="8,0,0,0"
                                    Click="LaudoViewerCompartilhar_Click" />
                            <Button Style="{StaticResource TopBarIconButtonStyle}"
                                    Margin="8,0,0,0"
                                    ToolTip="Fechar visualizador"
                                    Click="LaudoViewerFechar_Click">
                                <TextBlock Text="✕" Foreground="#CFC8BF" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- PDF -->
                <Border Grid.Row="1" Background="#3A3129" CornerRadius="0,0,14,14">
                    <wv2:WebView2 x:Name="LaudoViewerWebView" />
                </Border>
            </Grid>
        </Grid>

        <!-- Avisos flutuantes (lembretes de consulta) -->
        <StackPanel x:Name="ToastHost"
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,14,20,0"
                    Width="340"
                    Panel.ZIndex="999" />

        <!-- ===== RODAPE ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FooterSidebarColumn" Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Continuacao do menu marrom ate o fim da janela -->
            <Border Background="{StaticResource SparkSidebarBrush}" />

            <Border Grid.Column="1"
                    Background="{StaticResource SparkSurfaceBrush}"
                    BorderBrush="{StaticResource SparkLineBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,8">
                <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource SparkFaintBrush}">
                    <Run Text="Feito com" />
                    <Run Text="♥" Foreground="{StaticResource SparkAccentBrush}" />
                    <Run Text="pela Sparkware" />
                </TextBlock>
            </Border>
        </Grid>
    </Grid>
</Window>

<Window x:Class="AgendamentoWpfApp.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AgendamentoWpfApp.Views"
        Title="SparkCore"
        Icon="Assets/SparkCore.ico"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SparkPageBrush}">
    <!-- Shell conforme handoff "SparkCore App": header branco, sidebar escura, conteudo bege.
         Todos os estilos vem de Styles/; aqui ficam apenas os estilos implicitos da janela. -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SparkInkBrush}" />
        </Style>

        <Style TargetType="Label" BasedOn="{StaticResource SparkFormLabelStyle}" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource SparkPanelBrush}"
                BorderBrush="{StaticResource SparkLineBrush}"
                BorderThickness="0,0,0,1"
                Padding="28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo: raio + circulo tracejado -->
                    <Border Width="44" Height="44" CornerRadius="13"
                            Background="{StaticResource SparkLogoGradientBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="#E0670A" BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.6" />
                        </Border.Effect>
                        <Grid Width="27" Height="27">
                            <Ellipse Width="23" Height="23"
                                     Stroke="#8CFFFFFF" StrokeThickness="2"
                                     StrokeDashArray="7.2,3.2" StrokeDashCap="Round" />
                            <Path Data="M17.6,6.8 L10.4,17.2 L14.7,17.2 L13.7,25.2 L21.6,13.8 L17,13.8 Z"
                                  Fill="White" Stretch="Uniform" Width="11" Height="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0" />
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="SparkCore" FontSize="19" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock x:Name="SessionSummaryTextBlock"
                                       Foreground="#8A8378"
                                       FontSize="12.5"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                            <Border Background="{StaticResource SparkPageBrush}"
                                    BorderBrush="{StaticResource SparkLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="ApiChipTextBlock"
                                           Foreground="{StaticResource SparkFaintBrush}"
                                           FontFamily="Consolas"
                                           FontSize="11" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Sair -->
                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource SparkGhostButtonStyle}"
                        Click="LogoutButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource SparkNavIconStyle}"
                              Data="M9,21 L5,21 C3.9,21 3,20.1 3,19 L3,5 C3,3.9 3.9,3 5,3 L9,3 M16,17 L21,12 L16,7 M21,12 L9,12"
                              StrokeThickness="2"
                              Width="16" Height="16"
                              Margin="0,0,8,0" />
                        <TextBlock Text="Sair" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ===== CORPO ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR escura -->
            <Border Grid.Column="0" Background="{StaticResource SparkSidebarBrush}">
                <Grid ClipToBounds="True">
                    <!-- Glow que respira -->
                    <Ellipse Width="300" Height="300"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-120,-90,0,0"
                             RenderTransformOrigin="0.5,0.5"
                             Opacity="0.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#29F7931E" Offset="0" />
                                <GradientStop Color="#00F7931E" Offset="0.66" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.5" To="0.85" Duration="0:0:4.5" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         From="1" To="1.05" Duration="0:0:4.5" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         From="1" To="1.05" Duration="0:0:4.5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                    <!-- Quadriculado -->
                    <Border Background="{StaticResource SparkGridTextureBrush}" Opacity="0.4">
                        <Border.OpacityMask>
                            <RadialGradientBrush Center="0.3,0.1" GradientOrigin="0.3,0.1" RadiusX="1.2" RadiusY="0.8">
                                <GradientStop Color="#FF000000" Offset="0.3" />
                                <GradientStop Color="#00000000" Offset="0.8" />
                            </RadialGradientBrush>
                        </Border.OpacityMask>
                    </Border>

                    <Grid Margin="16,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="M Ó D U L O S"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="#52FFFFFF"
                                   Margin="13,6,0,12" />

                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                            <Button x:Name="NavClientesButton"
                                    Style="{StaticResource SparkNavButtonStyle}"
                                    Tag="Active"
                                    Click="MenuClientesButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource SparkNavIconStyle}"
                                          Data="M16,21 L16,19 C16,16.8 14.2,15 12,15 L6,15 C3.8,15 2,16.8 2,19 L2,21 M13,7 A4,4 0 1 1 5,7 A4,4 0 1 1 13,7 M22,21 L22,19 C22,17.2 20.8,15.6 19,15.1 M16,3.1 C17.8,3.6 19,5.2 19,7 C19,8.8 17.8,10.4 16,10.9"
                                          Margin="0,0,12,0" />
                                    <TextBlock Text="Clientes" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavAgendaButton"
                                    Style="{StaticResource SparkNavButtonStyle}"
                                    Click="MenuAgendaButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource SparkNavIconStyle}"
                                          Data="M6,4 L18,4 C19.7,4 21,5.3 21,7 L21,19 C21,20.7 19.7,22 18,22 L6,22 C4.3,22 3,20.7 3,19 L3,7 C3,5.3 4.3,4 6,4 Z M16,2 L16,6 M8,2 L8,6 M3,10 L21,10"
                                          Margin="0,0,12,0" />
                                    <TextBlock Text="Agenda" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavServicosButton"
                                    Style="{StaticResource SparkNavButtonStyle}"
                                    IsEnabled="False">
                                <Grid HorizontalAlignment="Stretch" Width="178">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SparkNavIconStyle}"
                                              Data="M3,3 L10,3 L10,10 L3,10 Z M14,3 L21,3 L21,10 L14,10 Z M3,14 L10,14 L10,21 L3,21 Z M14,14 L21,14 L21,21 L14,21 Z"
                                              Margin="0,0,12,0" />
                                        <TextBlock Text="Serviços" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                            BorderBrush="#24FFFFFF" BorderThickness="1"
                                            CornerRadius="5" Padding="6,2">
                                        <TextBlock Text="EM BREVE" FontSize="9" FontWeight="SemiBold" Foreground="#4DFFFFFF" />
                                    </Border>
                                </Grid>
                            </Button>

                            <Button x:Name="NavProfissionaisButton"
                                    Style="{StaticResource SparkNavButtonStyle}"
                                    Click="MenuProfissionaisButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource SparkNavIconStyle}"
                                          Data="M16,21 L16,19 C16,16.8 14.2,15 12,15 L6,15 C3.8,15 2,16.8 2,19 L2,21 M13,7 A4,4 0 1 1 5,7 A4,4 0 1 1 13,7 M17,11 L19,13 L23,9"
                                          Margin="0,0,12,0" />
                                    <TextBlock Text="Profissionais" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavLaudosButton"
                                    Style="{StaticResource SparkNavButtonStyle}"
                                    Click="MenuLaudosButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource SparkNavIconStyle}"
                                          Data="M14,2 L6,2 C4.9,2 4,2.9 4,4 L4,20 C4,21.1 4.9,22 6,22 L18,22 C19.1,22 20,21.1 20,20 L20,8 Z M14,2 L14,8 L20,8 M16,13 L8,13 M16,17 L8,17 M10,9 L8,9"
                                          Margin="0,0,12,0" />
                                    <TextBlock Text="Laudos" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavConfiguracoesButton"
                                    Style="{StaticResource SparkNavButtonStyle}"
                                    Click="MenuConfiguracoesButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource SparkNavIconStyle}"
                                          Data="M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 M19.4,15 C19.1,15.6 19.2,16.4 19.7,16.9 L19.8,17 C20.6,17.8 20.6,19 19.8,19.8 C19,20.6 17.8,20.6 17,19.8 L16.9,19.7 C16.4,19.2 15.6,19.1 15,19.4 C14.4,19.7 14,20.3 14,21 L14,21 C14,22.1 13.1,23 12,23 C10.9,23 10,22.1 10,21 L10,20.9 C10,20.2 9.6,19.6 9,19.4 C8.4,19.1 7.6,19.2 7.1,19.7 L7,19.8 C6.2,20.6 5,20.6 4.2,19.8 C3.4,19 3.4,17.8 4.2,17 L4.3,16.9 C4.8,16.4 4.9,15.6 4.6,15 C4.3,14.4 3.7,14 3,14 L3,14 C1.9,14 1,13.1 1,12 C1,10.9 1.9,10 3,10 L3.1,10 C3.8,10 4.4,9.6 4.6,9 C4.9,8.4 4.8,7.6 4.3,7.1 L4.2,7 C3.4,6.2 3.4,5 4.2,4.2 C5,3.4 6.2,3.4 7,4.2 L7.1,4.3 C7.6,4.8 8.4,4.9 9,4.6 L9,4.6 C9.6,4.3 10,3.7 10,3 L10,3 C10,1.9 10.9,1 12,1 C13.1,1 14,1.9 14,3 L14,3.1 C14,3.8 14.4,4.4 15,4.6 C15.6,4.9 16.4,4.8 16.9,4.3 L17,4.2 C17.8,3.4 19,3.4 19.8,4.2 C20.6,5 20.6,6.2 19.8,7 L19.7,7.1 C19.2,7.6 19.1,8.4 19.4,9 L19.4,9 C19.7,9.6 20.3,10 21,10 L21,10 C22.1,10 23,10.9 23,12 C23,13.1 22.1,14 21,14 L20.9,14 C20.2,14 19.6,14.4 19.4,15 Z"
                                          Margin="0,0,12,0" />
                                    <TextBlock Text="Configurações" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Rodape da sidebar -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,0,0,0">
                            <Ellipse Width="7" Height="7" Fill="#22C55E" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#22C55E" BlurRadius="6" ShadowDepth="0" Opacity="0.9" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock x:Name="SidebarStatusTextBlock"
                                       Text="Conectado · v1.0.0"
                                       FontSize="11"
                                       Foreground="#4DFFFFFF"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- CONTEUDO -->
            <TabControl x:Name="MainTabControl"
                        Grid.Column="1"
                        Margin="34,30,34,20"
                        BorderThickness="0"
                        Background="Transparent"
                        ItemContainerStyle="{StaticResource SparkHiddenTabItemStyle}">
                <TabItem Header="Clientes">
                    <views:ClientesView x:Name="ClientesView"
                                        SearchChanged="ClientesView_SearchChanged"
                                        SelectionChanged="ClientesView_SelectionChanged"
                                        SaveRequested="ClientesView_SaveRequested"
                                        NewRequested="ClientesView_NewRequested"
                                        DeleteRequested="ClientesView_DeleteRequested" />
                </TabItem>

                <TabItem Header="Agenda">
                    <views:AgendaView x:Name="AgendaView"
                                      DateChanged="AgendaView_DateChanged"
                                      SelectionChanged="AgendaView_SelectionChanged"
                                      SaveRequested="AgendaView_SaveRequested"
                                      NewRequested="AgendaView_NewRequested"
                                      DeleteRequested="AgendaView_DeleteRequested" />
                </TabItem>

                <TabItem Header="Profissionais">
                    <views:ProfissionaisView x:Name="ProfissionaisView"
                                             SelectionChanged="ProfissionaisView_SelectionChanged"
                                             SaveRequested="ProfissionaisView_SaveRequested"
                                             NewRequested="ProfissionaisView_NewRequested"
                                             DeleteRequested="ProfissionaisView_DeleteRequested" />
                </TabItem>

                <TabItem Header="Laudos">
                    <views:LaudosView x:Name="LaudosView"
                                      ClienteSelectionChanged="LaudosView_ClienteSelectionChanged"
                                      GerarPdfRequested="LaudosView_GerarPdfRequested" />
                </TabItem>

                <TabItem Header="Configuracoes">
                    <views:ConfiguracoesView x:Name="ConfiguracoesView"
                                             LogoutRequested="ConfiguracoesView_LogoutRequested" />
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ===== RODAPE ===== -->
        <Border Grid.Row="2"
                Background="{StaticResource SparkPageBrush}"
                BorderBrush="{StaticResource SparkLineBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource SparkFaintBrush}">
                <Run Text="Feito com" />
                <Run Text="♥" Foreground="{StaticResource SparkAccentBrush}" />
                <Run Text="pela Sparkware" />
            </TextBlock>
        </Border>
    </Grid>
</Window>

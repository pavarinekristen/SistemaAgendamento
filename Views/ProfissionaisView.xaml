<UserControl x:Class="AgendamentoWpfApp.Views.ProfissionaisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Profissionais e salas"
                       Style="{StaticResource SparkSectionTitleStyle}" />
            <TextBlock Text="{Binding CountText}"
                       Foreground="{StaticResource SparkMutedBrush}"
                       FontSize="13"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SparkPanelBrush}"
                    BorderBrush="{StaticResource SparkLineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Cadastro"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14" />

                    <Label Content="Nome" />
                    <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SparkTextBoxStyle}" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="Tipo" />
                            <ComboBox ItemsSource="{Binding Tipos}"
                                      SelectedItem="{Binding Tipo, Mode=TwoWay}"
                                      Style="{StaticResource SparkComboBoxStyle}">
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Especialidade/funcao" />
                            <TextBox Text="{Binding EspecialidadeFuncao, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="Telefone" />
                            <TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="E-mail" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <Label Content="Observacoes" Margin="0,10,0,0" />
                    <TextBox Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="86"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="9,7"
                             BorderBrush="{StaticResource SparkLineBrush}"
                             BorderThickness="1" />

                    <CheckBox Content="Ativo"
                              IsChecked="{Binding Ativo, Mode=TwoWay}"
                              Margin="0,12,0,0" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{Binding StatusBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />

                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="Salvar"
                                Style="{StaticResource SparkPrimaryButtonStyle}"
                                Command="{Binding SaveCommand}" />
                        <Button Content="Novo"
                                Style="{StaticResource SparkSecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                Command="{Binding NewCommand}" />
                        <Button Content="Excluir"
                                Style="{StaticResource SparkDangerButtonStyle}"
                                Margin="8,0,0,0"
                                Command="{Binding DeleteCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource SparkPanelBrush}"
                    BorderBrush="{StaticResource SparkLineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10">
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          BorderThickness="0"
                          AlternatingRowBackground="#FAF6EC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120" />
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="2*" />
                        <DataGridTextColumn Header="Funcao" Binding="{Binding EspecialidadeFuncao}" Width="*" />
                        <DataGridTextColumn Header="Telefone" Binding="{Binding TelefoneFormatado}" Width="130" />
                        <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

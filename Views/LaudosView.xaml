<UserControl x:Class="AgendamentoWpfApp.Views.LaudosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Historico de laudos" Style="{StaticResource SparkSectionTitleStyle}" />
            <TextBlock Text="Filtre por periodo, empresa, funcionario e motivo para baixar ou imprimir os laudos."
                       Style="{StaticResource SparkSubtitleStyle}" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource SparkCardStyle}"
                Padding="18"
                Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Label Content="De" />
                    <DatePicker x:Name="DataInicialDatePicker"
                                Style="{StaticResource SparkDatePickerStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="Ate" />
                    <DatePicker x:Name="DataFinalDatePicker"
                                Style="{StaticResource SparkDatePickerStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <Label Content="Empresa" />
                    <TextBox x:Name="EmpresaTextBox"
                             Style="{StaticResource SparkTextBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <Label Content="Funcionario" />
                    <TextBox x:Name="FuncionarioTextBox"
                             Style="{StaticResource SparkTextBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="8">
                    <Label Content="Motivo" />
                    <ComboBox x:Name="MotivoComboBox"
                              Style="{StaticResource SparkComboBoxStyle}" />
                </StackPanel>

                <WrapPanel Grid.Row="1"
                           Grid.ColumnSpan="9"
                           Margin="0,16,0,0"
                           VerticalAlignment="Bottom">
                    <Button Content="Filtrar"
                            Style="{StaticResource SparkPrimaryButtonStyle}"
                            Click="FiltrarButton_Click" />
                    <Button Content="Baixar laudo"
                            Style="{StaticResource SparkSecondaryButtonStyle}"
                            Margin="10,0,0,0"
                            Click="BaixarLaudoButton_Click" />
                    <Button Content="Imprimir lista"
                            Style="{StaticResource SparkSecondaryButtonStyle}"
                            Margin="10,0,0,0"
                            Click="ImprimirButton_Click" />
                    <Button Content="Excluir"
                            Style="{StaticResource SparkDangerButtonStyle}"
                            Margin="10,0,0,0"
                            Click="ExcluirButton_Click" />
                    <TextBlock x:Name="LaudoStatusTextBlock"
                               Foreground="{StaticResource SparkMutedBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SparkCardStyle}" Padding="6">
            <DataGrid x:Name="LaudosDataGrid"
                      Style="{StaticResource SparkDataGridStyle}"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DATA" Binding="{Binding DataTexto}" Width="95" />
                    <DataGridTextColumn Header="HORARIO" Binding="{Binding Horario}" Width="90" />
                    <DataGridTextColumn Header="FUNCIONARIO" Binding="{Binding ClienteNome}" Width="1.4*" />
                    <DataGridTextColumn Header="EMPRESA" Binding="{Binding Empresa}" Width="1.2*" />
                    <DataGridTextColumn Header="CARGO" Binding="{Binding ClienteCargo}" Width="1.1*" />
                    <DataGridTextColumn Header="MOTIVO" Binding="{Binding Motivo}" Width="130" />
                    <DataGridTextColumn Header="LAUDO" Binding="{Binding TipoLaudo}" Width="100" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110" />
                    <DataGridTextColumn Header="OBS" Binding="{Binding Observacoes}" Width="1.3*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>

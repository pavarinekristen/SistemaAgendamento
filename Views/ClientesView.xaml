<UserControl x:Class="AgendamentoWpfApp.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Clientes"
                           Style="{StaticResource SparkSectionTitleStyle}" />
                <TextBlock Text="{Binding CountText}"
                           Foreground="{StaticResource SparkMutedBrush}"
                           FontSize="13"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1">
                <Label Content="Pesquisa" />
                <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SparkTextBoxStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SparkPanelBrush}"
                    BorderBrush="{StaticResource SparkLineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,0,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Cadastro de cliente"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,14" />

                        <Label Content="Nome completo" />
                        <TextBox x:Name="NomeTextBox"
                                 Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SparkTextBoxStyle}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="CPF" />
                                <TextBox Text="{Binding Cpf, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SparkTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Nascimento" />
                                <DatePicker SelectedDate="{Binding DataNascimento, Mode=TwoWay}"
                                            Style="{StaticResource SparkDatePickerStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="Telefone" />
                                <TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SparkTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="E-mail" />
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SparkTextBoxStyle}" />
                            </StackPanel>
                        </Grid>

                        <Label Content="Endereco" Margin="0,10,0,0" />
                        <TextBox Text="{Binding Endereco, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SparkTextBoxStyle}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="Bairro" />
                                <TextBox Text="{Binding Bairro, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SparkTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Cidade" />
                                <TextBox Text="{Binding Cidade, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SparkTextBoxStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="Observacoes" />
                                <TextBox Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="72"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="9,7"
                                         BorderBrush="{StaticResource SparkLineBrush}"
                                         BorderThickness="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Status" />
                                <ComboBox ItemsSource="{Binding StatusOptions}"
                                          SelectedItem="{Binding Status, Mode=TwoWay}"
                                          Style="{StaticResource SparkComboBoxStyle}">
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{Binding StatusBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />

                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="Salvar"
                                    Style="{StaticResource SparkPrimaryButtonStyle}"
                                    Command="{Binding SaveCommand}" />
                            <Button Content="Novo"
                                    Style="{StaticResource SparkSecondaryButtonStyle}"
                                    Margin="8,0,0,0"
                                    Command="{Binding NewCommand}" />
                            <Button Content="Excluir"
                                    Style="{StaticResource SparkDangerButtonStyle}"
                                    Margin="8,0,0,0"
                                    Command="{Binding DeleteCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource SparkPanelBrush}"
                        BorderBrush="{StaticResource SparkLineBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10">
                    <DataGrid ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              BorderThickness="0"
                              AlternatingRowBackground="#FAF6EC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="2*" />
                            <DataGridTextColumn Header="CPF" Binding="{Binding CpfFormatado}" Width="120" />
                            <DataGridTextColumn Header="Telefone" Binding="{Binding TelefoneFormatado}" Width="130" />
                            <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="1"
                        Background="{StaticResource SparkPanelBrush}"
                        BorderBrush="{StaticResource SparkLineBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding DetailName}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DetailContact}"
                                       Foreground="{StaticResource SparkMutedBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding DetailAddress}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailNotes}"
                                       Foreground="{StaticResource SparkMutedBrush}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

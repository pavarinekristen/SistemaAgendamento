<UserControl x:Class="AgendamentoWpfApp.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Cadastro de funcionario" Style="{StaticResource SparkSectionTitleStyle}" />
            <TextBlock Text="{Binding CountText}" Style="{StaticResource SparkSubtitleStyle}" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource SparkCardStyle}"
                Padding="28"
                VerticalAlignment="Top">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Style="{StaticResource SparkIconChipStyle}">
                            <Path Data="M19,21 L19,19 C19,16.8 17.2,15 15,15 L9,15 C6.8,15 5,16.8 5,19 L5,21 M16,7 A4,4 0 1 1 8,7 A4,4 0 1 1 16,7"
                                  Stroke="{StaticResource SparkAccentBrush}" StrokeThickness="2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="18" Height="18" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Dados cadastrais"
                                   Style="{StaticResource SparkCardTitleStyle}"
                                   Margin="10,0,0,0" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Label Content="Nome completo" />
                            <TextBox x:Name="NomeTextBox"
                                     Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Empresa" />
                            <TextBox Text="{Binding Empresa, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Label Content="Cargo" />
                            <TextBox Text="{Binding Cargo, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Label Content="CPF" />
                            <TextBox Text="{Binding Cpf, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="RG" />
                            <TextBox Text="{Binding Rg, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Label Content="Nascimento" />
                            <DatePicker SelectedDate="{Binding DataNascimento, Mode=TwoWay}"
                                        Style="{StaticResource SparkDatePickerStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Label Content="Sexo" />
                            <ComboBox ItemsSource="{Binding SexoOptions}"
                                      SelectedItem="{Binding Sexo, Mode=TwoWay}"
                                      Style="{StaticResource SparkComboBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Telefone" />
                            <TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Label Content="E-mail" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Label Content="Escolaridade" />
                            <TextBox Text="{Binding Escolaridade, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Estado civil" />
                            <ComboBox ItemsSource="{Binding EstadoCivilOptions}"
                                      SelectedItem="{Binding EstadoCivil, Mode=TwoWay}"
                                      Style="{StaticResource SparkComboBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Label Content="Naturalidade" />
                            <TextBox Text="{Binding Naturalidade, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Label Content="Tipo de endereco" />
                            <ComboBox ItemsSource="{Binding TipoEnderecoOptions}"
                                      SelectedItem="{Binding TipoEndereco, Mode=TwoWay}"
                                      Style="{StaticResource SparkComboBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Endereco" />
                            <TextBox Text="{Binding Endereco, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Label Content="Bairro" />
                            <TextBox Text="{Binding Bairro, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Label Content="Cidade" />
                            <TextBox Text="{Binding Cidade, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Observacoes" />
                            <TextBox Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextAreaStyle}"
                                     MinHeight="92" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Label Content="Status" />
                            <ComboBox ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding Status, Mode=TwoWay}"
                                      Style="{StaticResource SparkComboBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{Binding StatusBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,14,0,0" />

                    <WrapPanel Margin="0,16,0,0">
                        <Button Content="Salvar"
                                Style="{StaticResource SparkPrimaryButtonStyle}"
                                Command="{Binding SaveCommand}" />
                        <Button Content="Novo"
                                Style="{StaticResource SparkSecondaryButtonStyle}"
                                Margin="10,0,0,0"
                                Command="{Binding NewCommand}" />
                        <Button Content="Excluir"
                                Style="{StaticResource SparkDangerButtonStyle}"
                                Margin="10,0,0,0"
                                Command="{Binding DeleteCommand}" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

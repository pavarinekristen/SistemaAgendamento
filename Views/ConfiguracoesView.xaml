<UserControl x:Class="AgendamentoWpfApp.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Configuracoes"
                       Style="{StaticResource SparkSectionTitleStyle}" />
            <TextBlock Text="{Binding SyncStatus}"
                       Foreground="{Binding SyncStatusBrush}"
                       FontSize="13"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource SparkPanelBrush}"
                BorderBrush="{StaticResource SparkLineBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18">
            <StackPanel>
                <TextBlock Text="Sistema"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />
                <TextBlock Text="{Binding SyncDetails}"
                           Foreground="{StaticResource SparkMutedBrush}"
                           TextWrapping="Wrap" />

                <Border Background="#FAF6EC"
                        BorderBrush="{StaticResource SparkLineBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Backup local"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding BackupDetails}"
                                   Foreground="{StaticResource SparkMutedBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding BackupStatus}"
                                   Foreground="{Binding BackupStatusBrush}"
                                   FontSize="13"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Gerar backup agora"
                                    Style="{StaticResource SparkPrimaryButtonStyle}"
                                    Margin="0,0,8,8"
                                    Command="{Binding CreateBackupCommand}" />
                            <Button Content="Abrir pasta de dados"
                                    Style="{StaticResource SparkSecondaryButtonStyle}"
                                    Margin="0,0,8,8"
                                    Command="{Binding OpenDataFolderCommand}" />
                            <Button Content="Abrir backups"
                                    Style="{StaticResource SparkSecondaryButtonStyle}"
                                    Margin="0,0,8,8"
                                    Command="{Binding OpenBackupFolderCommand}" />
                            <Button Content="Restaurar backup"
                                    Style="{StaticResource SparkDangerButtonStyle}"
                                    Margin="0,0,8,8"
                                    Command="{Binding RestoreBackupCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Button Content="Sair do sistema"
                        Style="{StaticResource SparkDangerButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="0,18,0,0"
                        Command="{Binding LogoutCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="AgendamentoWpfApp.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Configurações" Style="{StaticResource SparkSectionTitleStyle}" />

            <!-- Pill de status da sincronizacao -->
            <Border Background="{StaticResource SparkSurfaceBrush}"
                    BorderBrush="{StaticResource SparkLineBrush}"
                    BorderThickness="1"
                    CornerRadius="999"
                    Padding="14,7"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,20">
                <TextBlock Text="{Binding SyncStatus}"
                           Foreground="{Binding SyncStatusBrush}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Card Sistema -->
            <Border Style="{StaticResource SparkCardStyle}" Padding="26" Margin="0,0,0,22">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Style="{StaticResource SparkIconChipStyle}">
                            <Path Data="M4,3 L20,3 C21.1,3 22,3.9 22,5 L22,15 C22,16.1 21.1,17 20,17 L4,17 C2.9,17 2,16.1 2,15 L2,5 C2,3.9 2.9,3 4,3 Z M8,21 L16,21 M12,17 L12,21"
                                  Stroke="{StaticResource SparkAccentBrush}" StrokeThickness="2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="18" Height="18" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Sistema"
                                   Style="{StaticResource SparkCardTitleStyle}"
                                   Margin="10,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding SyncDetails}"
                               Foreground="{StaticResource SparkBodyBrush}"
                               FontSize="12.5"
                               LineHeight="24"
                               TextWrapping="Wrap" />

                    <!-- Sub-card de backup -->
                    <Border Background="{StaticResource SparkSurfaceBrush}"
                            BorderBrush="{StaticResource SparkLineBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="22"
                            Margin="0,20,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="30" Height="30" CornerRadius="9"
                                        Background="{StaticResource SparkPanelBrush}"
                                        BorderBrush="#EAE3D9"
                                        BorderThickness="1">
                                    <Path Data="M21,5 C21,6.7 17,8 12,8 C7,8 3,6.7 3,5 C3,3.3 7,2 12,2 C17,2 21,3.3 21,5 Z M3,5 L3,19 C3,20.7 7,22 12,22 C17,22 21,20.7 21,19 L21,5 M3,12 C3,13.7 7,15 12,15 C17,15 21,13.7 21,12"
                                          Stroke="{StaticResource SparkAccentBrush}" StrokeThickness="2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="16" Height="16" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Backup local"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="{Binding BackupDetails}"
                                       Foreground="{StaticResource SparkBodyBrush}"
                                       FontSize="12"
                                       LineHeight="22"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding BackupStatus}"
                                       Foreground="{Binding BackupStatusBrush}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0" />

                            <WrapPanel Margin="0,16,0,0">
                                <Button Style="{StaticResource SparkPrimaryButtonStyle}"
                                        Height="42"
                                        Margin="0,0,10,10"
                                        Command="{Binding CreateBackupCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12,5 L12,19 M5,12 L19,12"
                                              Stroke="White" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="15" Height="15" Stretch="Uniform"
                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Gerar backup agora" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SparkSecondaryButtonStyle}"
                                        Height="42"
                                        Margin="0,0,10,10"
                                        Command="{Binding OpenDataFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M4,20 L20,20 C21.1,20 22,19.1 22,18 L22,8 C22,6.9 21.1,6 20,6 L12.1,6 L9.6,3.9 C9.2,3.6 8.8,3.4 8.3,3.4 L4,3.4 C2.9,3.4 2,4.3 2,5.4 L2,18 C2,19.1 2.9,20 4,20 Z"
                                              Stroke="#57503F" StrokeThickness="2"
                                              StrokeLineJoin="Round"
                                              Width="15" Height="15" Stretch="Uniform"
                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Abrir pasta de dados" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SparkSecondaryButtonStyle}"
                                        Height="42"
                                        Margin="0,0,10,10"
                                        Command="{Binding OpenBackupFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M4,20 L20,20 C21.1,20 22,19.1 22,18 L22,8 C22,6.9 21.1,6 20,6 L12.1,6 L9.6,3.9 C9.2,3.6 8.8,3.4 8.3,3.4 L4,3.4 C2.9,3.4 2,4.3 2,5.4 L2,18 C2,19.1 2.9,20 4,20 Z"
                                              Stroke="#57503F" StrokeThickness="2"
                                              StrokeLineJoin="Round"
                                              Width="15" Height="15" Stretch="Uniform"
                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Abrir backups" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SparkDangerButtonStyle}"
                                        Height="42"
                                        Margin="0,0,10,10"
                                        Command="{Binding RestoreBackupCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M3,12 A9,9 0 1 0 12,3 A9,9 0 0 0 5.6,5.7 L3,8 M3,3 L3,8 L8,8"
                                              Stroke="White" StrokeThickness="2"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="15" Height="15" Stretch="Uniform"
                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Restaurar backup" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Sair do sistema -->
            <Button Style="{StaticResource SparkDangerOutlineButtonStyle}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,20"
                    Command="{Binding LogoutCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M9,21 L5,21 C3.9,21 3,20.1 3,19 L3,5 C3,3.9 3.9,3 5,3 L9,3 M16,17 L21,12 L16,7 M21,12 L9,12"
                          Stroke="{StaticResource SparkDangerBrush}" StrokeThickness="2"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="17" Height="17" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock Text="Sair do sistema" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>

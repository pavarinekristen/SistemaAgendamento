<UserControl x:Class="AgendamentoWpfApp.Views.AgendaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabecalho -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="Agenda" Style="{StaticResource SparkSectionTitleStyle}" />
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource SparkSubtitleStyle}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="{StaticResource SparkPanelBrush}"
                        BorderBrush="{StaticResource SparkLineBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="16,9"
                        VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M6,4 L18,4 C19.7,4 21,5.3 21,7 L21,19 C21,20.7 19.7,22 18,22 L6,22 C4.3,22 3,20.7 3,19 L3,7 C3,5.3 4.3,4 6,4 Z M16,2 L16,6 M8,2 L8,6 M3,10 L21,10"
                              Stroke="{StaticResource SparkAccentBrush}" StrokeThickness="2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding HeaderDateText}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Calendario + consultas -->
            <Grid Grid.Row="1" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource SparkCardStyle}"
                        Padding="20"
                        Margin="0,0,22,0"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Calendário"
                                   Style="{StaticResource SparkCardTitleStyle}"
                                   FontSize="15"
                                   Margin="0,0,0,14" />
                        <Calendar SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                  Style="{StaticResource SparkCalendarStyle}"
                                  HorizontalAlignment="Center" />
                        <Border Background="{StaticResource SparkSoftAccentBrush}"
                                BorderBrush="#F7DCC2"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="14,12"
                                Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M22,12 A10,10 0 1 1 2,12 A10,10 0 1 1 22,12 M12,16 L12,12 M12,8 L12.01,8"
                                      Stroke="{StaticResource SparkAccentTextBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="18" Height="18" Stretch="Uniform"
                                      VerticalAlignment="Top" Margin="0,2,11,0" />
                                <TextBlock Text="O mesmo horário ativo fica bloqueado para evitar duas consultas marcadas ao mesmo tempo."
                                           Foreground="#A35407"
                                           FontSize="12.5"
                                           LineHeight="19"
                                           MaxWidth="200"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SparkCardStyle}" Padding="6">
                    <DataGrid ItemsSource="{Binding ConsultasSource}"
                              SelectedItem="{Binding SelectedConsulta, Mode=TwoWay}"
                              Style="{StaticResource SparkDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="HORÁRIO" Binding="{Binding Horario}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="FontSize" Value="13.5" />
                                        <Setter Property="Foreground" Value="{StaticResource SparkAccentBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CLIENTE" Binding="{Binding ClienteNome}" Width="1.7*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="FontSize" Value="13.5" />
                                        <Setter Property="Foreground" Value="{StaticResource SparkTextBrush}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="EMPRESA" Binding="{Binding Empresa}" Width="1.1*" />
                            <DataGridTextColumn Header="MOTIVO" Binding="{Binding Motivo}" Width="120" />
                            <DataGridTextColumn Header="LAUDO" Binding="{Binding TipoLaudo}" Width="100" />
                            <DataGridTextColumn Header="LOCAL" Binding="{Binding Local}" Width="*" />
                            <DataGridTextColumn Header="PROFISSIONAL/SALA" Binding="{Binding ProfissionalSala}" Width="1.2*" />
                            <DataGridTemplateColumn Header="STATUS" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SparkStatusPillStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource SparkStatusDotStyle}" />
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource SparkStatusPillTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- Agendar consulta -->
            <Border Grid.Row="2" Style="{StaticResource SparkCardStyle}" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Style="{StaticResource SparkIconChipStyle}">
                            <Path Data="M6,4 L18,4 C19.7,4 21,5.3 21,7 L21,19 C21,20.7 19.7,22 18,22 L6,22 C4.3,22 3,20.7 3,19 L3,7 C3,5.3 4.3,4 6,4 Z M16,2 L16,6 M8,2 L8,6 M3,10 L21,10 M12,14 L12,18 M10,16 L14,16"
                                  Stroke="{StaticResource SparkAccentBrush}" StrokeThickness="2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="18" Height="18" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Agendar consulta"
                                   Style="{StaticResource SparkCardTitleStyle}"
                                   Margin="10,0,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Label Content="Cliente cadastrado" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ClienteSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SparkTextBoxStyle}" />
                                <Button Grid.Column="2"
                                        Content="Buscar"
                                        Style="{StaticResource SparkSecondaryButtonStyle}"
                                        Click="ClienteSearchButton_Click" />
                            </Grid>
                            <ComboBox ItemsSource="{Binding ClienteCandidatesSource}"
                                      DisplayMemberPath="Nome"
                                      SelectedItem="{Binding SelectedCliente, Mode=TwoWay}"
                                      Style="{StaticResource SparkComboBoxStyle}"
                                      Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Label Content="Dia" />
                            <DatePicker SelectedDate="{Binding FormDate, Mode=TwoWay}"
                                        Style="{StaticResource SparkDatePickerStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <Label Content="Horário" />
                            <TextBox Text="{Binding Horario, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextBoxStyle}"
                                     LostFocus="ConsultaHorarioTextBox_LostFocus" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <Label Content="Local" />
                            <TextBox Text="{Binding Local, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="8">
                            <Label Content="Profissional ou sala" />
                            <ComboBox ItemsSource="{Binding ProfissionaisSource}"
                                      DisplayMemberPath="NomeExibicao"
                                      SelectedValuePath="IdLocal"
                                      SelectedValue="{Binding SelectedProfissionalId, Mode=TwoWay}"
                                      Style="{StaticResource SparkComboBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="10">
                            <Label Content="Status" />
                            <ComboBox ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding Status, Mode=TwoWay}"
                                      Style="{StaticResource SparkComboBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="Motivo" />
                                    <ComboBox ItemsSource="{Binding MotivoOptions}"
                                              SelectedItem="{Binding Motivo, Mode=TwoWay}"
                                              Style="{StaticResource SparkComboBoxStyle}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2"
                                          Content="Trabalha armado"
                                          IsChecked="{Binding TrabalhaArmado, Mode=TwoWay}"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,0,12" />
                                <TextBlock Grid.Column="4"
                                           Text="Sem arma usa o modelo da pagina 1; com arma usa o modelo da pagina 2."
                                           Foreground="{StaticResource SparkMutedBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,8" />
                            </Grid>
                            <Label Content="Observações" />
                            <TextBox Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SparkTextAreaStyle}"
                                     MinHeight="76" />
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{Binding StatusBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,22">
                            <Button Content="Salvar"
                                    Style="{StaticResource SparkPrimaryButtonStyle}"
                                    Command="{Binding SaveCommand}" />
                            <Button Content="Nova"
                                    Style="{StaticResource SparkSecondaryButtonStyle}"
                                    Margin="10,0,0,0"
                                    Command="{Binding NewCommand}" />
                            <Button Content="Excluir"
                                    Style="{StaticResource SparkDangerButtonStyle}"
                                    Margin="10,0,0,0"
                                    Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

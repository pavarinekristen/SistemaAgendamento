<UserControl x:Class="AgendamentoWpfApp.Views.PesquisaClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Pesquisa de funcionarios" Style="{StaticResource SparkSectionTitleStyle}" />
            <TextBlock x:Name="CountTextBlock" Style="{StaticResource SparkSubtitleStyle}" />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource SparkCardStyle}"
                Padding="18"
                Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <TextBox x:Name="SearchTextBox"
                             Style="{StaticResource SparkTextBoxStyle}"
                             Background="{StaticResource SparkPanelBrush}"
                             Height="44"
                             Padding="40,0,14,0"
                             TextChanged="Filter_Changed" />
                    <Path Data="M19,11 A8,8 0 1 1 3,11 A8,8 0 1 1 19,11 M21,21 L16.7,16.7"
                          Stroke="{StaticResource SparkFaintBrush}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="17" Height="17" Stretch="Uniform"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="14,0,0,0" IsHitTestVisible="False" />
                </Grid>

                <ComboBox x:Name="EmpresaComboBox"
                          Grid.Column="2"
                          Style="{StaticResource SparkComboBoxStyle}"
                          SelectionChanged="Filter_Changed" />

                <Button Grid.Column="4"
                        Content="Editar cadastro"
                        Style="{StaticResource SparkPrimaryButtonStyle}"
                        Click="EditarButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SparkCardStyle}" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="ClientesDataGrid"
                          Style="{StaticResource SparkDataGridStyle}"
                          SelectionMode="Single"
                          SelectionChanged="ClientesDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdTexto}" Width="70" />
                        <DataGridTextColumn Header="NOME" Binding="{Binding Nome}" Width="1.5*" />
                        <DataGridTextColumn Header="EMPRESA" Binding="{Binding Empresa}" Width="1.2*" />
                        <DataGridTextColumn Header="CARGO" Binding="{Binding Cargo}" Width="1.1*" />
                        <DataGridTextColumn Header="CPF" Binding="{Binding CpfFormatado}" Width="130" />
                        <DataGridTextColumn Header="RG" Binding="{Binding Rg}" Width="110" />
                        <DataGridTextColumn Header="TELEFONE" Binding="{Binding TelefoneFormatado}" Width="140" />
                        <DataGridTextColumn Header="E-MAIL" Binding="{Binding Email}" Width="1.2*" />
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="1" Margin="10,8,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PageInfoTextBlock"
                               Foreground="{StaticResource SparkMutedBrush}"
                               FontSize="13"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="PaginaAnteriorButton"
                                Content="Anterior"
                                Style="{StaticResource SparkSecondaryButtonStyle}"
                                MinWidth="96"
                                IsEnabled="False"
                                Click="PaginaAnteriorButton_Click" />
                        <Button x:Name="ProximaPaginaButton"
                                Content="Proxima"
                                Style="{StaticResource SparkSecondaryButtonStyle}"
                                MinWidth="96"
                                Margin="10,0,0,0"
                                IsEnabled="False"
                                Click="ProximaPaginaButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource SparkCardStyle}"
                Padding="22,20"
                Margin="0,18,0,0"
                MinHeight="118">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="46" Height="46" CornerRadius="12"
                        Background="{StaticResource SparkLogoGradientBrush}"
                        VerticalAlignment="Top"
                        Margin="0,0,14,0">
                    <Path Data="M19,21 L19,19 C19,16.8 17.2,15 15,15 L9,15 C6.8,15 5,16.8 5,19 L5,21 M16,7 A4,4 0 1 1 8,7 A4,4 0 1 1 16,7"
                          Stroke="White" StrokeThickness="2"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="20" Height="20" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailNameTextBlock"
                               Text="Nenhum funcionario selecionado"
                               FontSize="16"
                               FontWeight="Bold" />
                    <TextBlock x:Name="DetailContactTextBlock"
                               Foreground="{StaticResource SparkMutedBrush}"
                               FontSize="13"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="DetailAddressTextBlock"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailNotesTextBlock"
                               Foreground="{StaticResource SparkMutedBrush}"
                               FontSize="13"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

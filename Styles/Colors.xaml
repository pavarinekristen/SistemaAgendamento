<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design system SparkCore (handoff "SparkCore App"): bege, laranja, preto e branco. -->
    <Color x:Key="SparkInkColor">#1C1917</Color>
    <Color x:Key="SparkTextColor">#2A2620</Color>
    <Color x:Key="SparkBodyColor">#6B6259</Color>
    <Color x:Key="SparkMutedColor">#9A938C</Color>
    <Color x:Key="SparkFaintColor">#B3ACA4</Color>
    <Color x:Key="SparkLineColor">#EEE7DD</Color>
    <Color x:Key="SparkInputLineColor">#E7E0D7</Color>
    <Color x:Key="SparkPanelColor">#FFFFFF</Color>
    <Color x:Key="SparkPageColor">#F6F2EC</Color>
    <Color x:Key="SparkSurfaceColor">#FAF7F2</Color>
    <Color x:Key="SparkFieldColor">#FAF8F6</Color>
    <Color x:Key="SparkAccentColor">#E0670A</Color>
    <Color x:Key="SparkAccentLightColor">#F7931E</Color>
    <Color x:Key="SparkAccentTextColor">#C25A08</Color>
    <Color x:Key="SparkSoftAccentColor">#FDEFE0</Color>
    <Color x:Key="SparkRowHoverColor">#FDF6EF</Color>
    <Color x:Key="SparkRowSelectedColor">#FDEEDE</Color>
    <Color x:Key="SparkDangerColor">#B23F2F</Color>
    <Color x:Key="SparkSuccessColor">#1F8A4C</Color>
    <Color x:Key="SparkOnlineColor">#22C55E</Color>

    <SolidColorBrush x:Key="SparkInkBrush" Color="{StaticResource SparkInkColor}" />
    <SolidColorBrush x:Key="SparkTextBrush" Color="{StaticResource SparkTextColor}" />
    <SolidColorBrush x:Key="SparkBodyBrush" Color="{StaticResource SparkBodyColor}" />
    <SolidColorBrush x:Key="SparkMutedBrush" Color="{StaticResource SparkMutedColor}" />
    <SolidColorBrush x:Key="SparkFaintBrush" Color="{StaticResource SparkFaintColor}" />
    <SolidColorBrush x:Key="SparkLineBrush" Color="{StaticResource SparkLineColor}" />
    <SolidColorBrush x:Key="SparkInputLineBrush" Color="{StaticResource SparkInputLineColor}" />
    <SolidColorBrush x:Key="SparkPanelBrush" Color="{StaticResource SparkPanelColor}" />
    <SolidColorBrush x:Key="SparkPageBrush" Color="{StaticResource SparkPageColor}" />
    <SolidColorBrush x:Key="SparkSurfaceBrush" Color="{StaticResource SparkSurfaceColor}" />
    <SolidColorBrush x:Key="SparkFieldBrush" Color="{StaticResource SparkFieldColor}" />
    <SolidColorBrush x:Key="SparkAccentBrush" Color="{StaticResource SparkAccentColor}" />
    <SolidColorBrush x:Key="SparkAccentTextBrush" Color="{StaticResource SparkAccentTextColor}" />
    <SolidColorBrush x:Key="SparkSoftAccentBrush" Color="{StaticResource SparkSoftAccentColor}" />
    <SolidColorBrush x:Key="SparkRowHoverBrush" Color="{StaticResource SparkRowHoverColor}" />
    <SolidColorBrush x:Key="SparkRowSelectedBrush" Color="{StaticResource SparkRowSelectedColor}" />
    <SolidColorBrush x:Key="SparkDangerBrush" Color="{StaticResource SparkDangerColor}" />
    <SolidColorBrush x:Key="SparkSuccessBrush" Color="{StaticResource SparkSuccessColor}" />
    <SolidColorBrush x:Key="SparkOnlineBrush" Color="{StaticResource SparkOnlineColor}" />

    <!-- Compatibilidade com estilos antigos -->
    <SolidColorBrush x:Key="SparkAccentHoverBrush" Color="#C95E0C" />

    <!-- Gradiente de acento (botoes primarios, logo, dia selecionado) -->
    <LinearGradientBrush x:Key="SparkAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7931E" Offset="0" />
        <GradientStop Color="#E0670A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SparkLogoGradientBrush" StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#FBA53B" Offset="0" />
        <GradientStop Color="#E0670A" Offset="1" />
    </LinearGradientBrush>

    <!-- Sidebar escura do app -->
    <LinearGradientBrush x:Key="SparkSidebarBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#2A1C12" Offset="0" />
        <GradientStop Color="#1D130C" Offset="0.55" />
        <GradientStop Color="#160E08" Offset="1" />
    </LinearGradientBrush>

    <!-- Item ativo da navegacao -->
    <LinearGradientBrush x:Key="SparkNavActiveBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#42F7931E" Offset="0" />
        <GradientStop Color="#1FE0670A" Offset="1" />
    </LinearGradientBrush>

    <!-- Fundo cinza da "mesa" (janelas de login/criar conta) -->
    <RadialGradientBrush x:Key="SparkDeskBrush" Center="0.5,-0.1" GradientOrigin="0.5,-0.1" RadiusX="1.1" RadiusY="1.1">
        <GradientStop Color="#E9EBEF" Offset="0" />
        <GradientStop Color="#C4C8CF" Offset="1" />
    </RadialGradientBrush>

    <!-- Barrinha decorativa horizontal -->
    <LinearGradientBrush x:Key="SparkAccentBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FBA53B" Offset="0" />
        <GradientStop Color="#E0670A" Offset="1" />
    </LinearGradientBrush>

    <!-- Painel escuro do login -->
    <LinearGradientBrush x:Key="SparkDarkPanelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#201914" Offset="0" />
        <GradientStop Color="#2C2118" Offset="0.65" />
        <GradientStop Color="#3A2A1C" Offset="1" />
    </LinearGradientBrush>

    <!-- Quadriculado sutil para paineis escuros -->
    <DrawingBrush x:Key="SparkGridTextureBrush" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#0AFFFFFF">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry Rect="0,0,32,1" />
                        <RectangleGeometry Rect="0,0,1,32" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
